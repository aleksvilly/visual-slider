# The app refuses to connect when this ref or URL targets another project.
SUPABASE_PROJECT_REF=yzayxussrpreiyknlnhi
SUPABASE_URL=https://yzayxussrpreiyknlnhi.supabase.co

# Low-privilege key used by server-rendered public reads and Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Privileged server-only key. Required by `npm run seed:pants`, not by the
# current Vercel runtime. Never prefix this variable with PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only key used by the synchronous URL-assisted analysis workflow.
# OpenRouter is attempted first; OpenAI remains the fallback provider.
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=openrouter/free

# Never prefix any provider variable with PUBLIC_.
OPENAI_API_KEY=

# Optional. The server defaults to gpt-5.6 when this is blank.
OPENAI_ANALYSIS_MODEL=
