# The app refuses to connect when this ref or URL targets another project.
SUPABASE_PROJECT_REF=yzayxussrpreiyknlnhi
SUPABASE_URL=https://yzayxussrpreiyknlnhi.supabase.co

# Low-privilege key used by server-rendered public reads and Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Privileged server-only key. Required by `npm run seed:pants`, not by the
# current Vercel runtime. Never prefix this variable with PUBLIC_.
SUPABASE_SECRET_KEY=
