---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseAdminRepository } from '../../lib/admin/supabaseAdminRepository.server';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

let cards: ReadonlyArray<readonly [string, number, string]> = [];
let dashboardError = '';
try {
  const repository = await createSupabaseAdminRepository(Astro);
  const [categories, items, sources, errors] = await Promise.all([
    repository.listCategories(),
    repository.listItems(),
    repository.listSources(),
    repository.listIngestionErrors(),
  ]);
  cards = [
    ['Categories', categories.length, 'categories'],
    ['Attributes', categories.reduce((total, category) => total + category.attributes.length, 0), 'attributes'],
    ['Catalog items', items.length, 'items'],
    ['Sources', sources.length, 'sources'],
    ['Recorded errors', errors.length, 'errors'],
    ['Review queue', 0, 'duplicates'],
  ];
} catch (error) {
  dashboardError = error instanceof Error ? error.message : 'Dashboard totals could not be loaded.';
}
---

<AdminLayout title="Dashboard" activeSection="dashboard">
  <header class="admin-page-head">
    <div>
      <p class="eyebrow">Phase 1 / platform foundation</p>
      <h1>Dashboard</h1>
    </div>
    <span class="admin-mode">Protected by Supabase Auth</span>
  </header>

  <section class="admin-callout">
    <strong>Platform seam active</strong>
    <p>
      Catalog totals and operational records now come from Supabase. Admin reads and writes use the signed-in user's cookie session and remain subject to the administrator RLS policies.
    </p>
  </section>

  {dashboardError ? (
    <section class="admin-error-state" role="alert"><p class="eyebrow">Database error</p><h2>Dashboard totals could not be loaded</h2><p>{dashboardError}</p></section>
  ) : (
    <section class="admin-stat-grid" aria-label="Catalog totals">
      {cards.map(([label, value, path]) => (
        <a href={`${base}admin/${path}/`}>
          <span>{label}</span>
          <strong>{value}</strong>
          <small>Inspect →</small>
        </a>
      ))}
    </section>
  )}

  <section class="admin-panel-grid">
    <article class="admin-panel">
      <p class="eyebrow">Manual adapter</p>
      <h2>One-item import</h2>
      <dl class="admin-definition-list">
        <div><dt>Authorization</dt><dd>Admin RLS</dd></div>
        <div><dt>Adapter</dt><dd>manual 1.0.0</dd></div>
        <div><dt>Observability</dt><dd>Runs + errors</dd></div>
        <div><dt>AI / scraping</dt><dd>Not used</dd></div>
      </dl>
    </article>
    <article class="admin-panel">
      <p class="eyebrow">Operational state</p>
      <h2>Observable imports</h2>
      <p>
        Each manual import creates an ingestion run and persists detailed failures. External adapters and AI analysis remain intentionally disconnected.
      </p>
    </article>
    <article class="admin-panel admin-panel-featured">
      <p class="eyebrow">Ranking diagnostics</p>
      <h2>Explain the order</h2>
      <p>Use the same scoring implementation as the Pants explorer and inspect every weighted distance.</p>
      <a class="admin-inline-link" href={`${base}admin/ranking/`}>Open Ranking Lab →</a>
    </article>
  </section>
</AdminLayout>
