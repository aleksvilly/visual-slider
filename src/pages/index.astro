---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pantsUrl = `${base}pants/`;
---

<BaseLayout title="Visual Slider — visual discovery by sliders">
  <section class="home-hero">
    <p class="eyebrow">Visual discovery engine / MVP 0.1</p>
    <h1>Search by feeling,<br />not vocabulary.</h1>
    <p class="lede">
      Existing designs are analyzed once. You move semantic sliders and the catalog re-ranks around what you mean.
      No prompt engineering required.
    </p>
    <div class="hero-actions">
      <a class="primary-button" href={pantsUrl}>Open Pants prototype</a>
      <a class="text-button" href="https://github.com/aleksvilly/visual-slider" target="_blank" rel="noreferrer">View repository ↗</a>
    </div>
  </section>

  <section class="principle-grid">
    <article>
      <span>01</span>
      <h2>Index</h2>
      <p>Collect references from stores, portfolios, creators, archives and partner catalogs.</p>
    </article>
    <article>
      <span>02</span>
      <h2>Understand</h2>
      <p>AI assigns numerical visual attributes and embeddings once, before the user searches.</p>
    </article>
    <article>
      <span>03</span>
      <h2>Slide</h2>
      <p>Normal → square. Casual → business. Soft → rigid. Results continuously move closer.</p>
    </article>
    <article>
      <span>04</span>
      <h2>Use</h2>
      <p>Buy the original, open the source, save a moodboard, or later send references to a maker.</p>
    </article>
  </section>

  <section class="category-preview">
    <div>
      <p class="eyebrow">First validation category</p>
      <h2>Fashion / Pants</h2>
    </div>
    <a class="category-card" href={pantsUrl}>
      <strong>6 semantic sliders</strong>
      <span>Soft ranking · Explore this · Moodboard</span>
      <b>OPEN →</b>
    </a>
  </section>
</BaseLayout>
