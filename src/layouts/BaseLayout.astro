---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Visual Slider — search existing visual references by feeling, not vocabulary.',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pantsUrl = `${base}pants/`;
const adminUrl = `${base}admin/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>VISUAL / SLIDER</a>
      <nav>
        <a href={pantsUrl}>Pants prototype</a>
        <a href={adminUrl}>Platform admin</a>
        <a href="https://github.com/aleksvilly/visual-slider" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
